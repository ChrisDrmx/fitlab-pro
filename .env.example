# --- Sauvegarde et synchronisation (front, prefixe VITE_) ---
VITE_SUPABASE_URL=https://whhpqdhiwhsfsigchbxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Analyses a la demande (serveur uniquement, jamais expose au navigateur) ---
# Une seule des deux suffit. OpenAI est utilise en priorite s'il est present.
OPENAI_API_KEY=
# Modele par defaut : gpt-5.6-luna (tier economique de la famille GPT-5.6).
# Alternatives : gpt-5.6-terra (intermediaire), gpt-5.6-sol / gpt-5.6 (frontier).
# OPENAI_MODEL=gpt-5.6-luna
# Profondeur de raisonnement : none | low | medium | high | xhigh | max
# Mesure sur une seance complete : low ~9 s, medium ~19 s, high ~50 s, pour une
# qualite d'extraction identique. Au-dela de medium on frole la limite de 60 s
# des fonctions Vercel. Defaut : medium.
# OPENAI_REASONING_EFFORT=medium

# Secours si OPENAI_API_KEY est absent.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
